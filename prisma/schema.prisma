// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SetType {
  WARMUP
  WORKING
}

enum WorkoutSessionOrigin {
  PLANNED
  FREE
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS

  QUADRICEPS
  HAMSTRINGS
  GLUTES
  ADDUCTORS
  HIP_ABDUCTORS
  CALVES

  CORE
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

enum ExerciseMediaType {
  IMAGE_SEQUENCE
  GIF
  VIDEO
}

model User {
  id                  String           @id
  accountType         AccountType      @default(ATHLETE)
  systemRole          SystemRole       @default(USER)
  accountSetupCompletedAt DateTime?    @db.Timestamptz()
  subscription        Subscription?
  billingCustomers    BillingCustomer[]
  adminAuditActions   AdminAuditLog[] @relation("AuditActor")
  adminAuditTargets   AdminAuditLog[] @relation("AuditTarget")
  workoutPlans        WorkoutPlan[]
  name                String
  email               String
  emailVerified       Boolean          @default(false)
  image               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessions            Session[]
  accounts            Account[]
  weightInGrams       Int?
  heightInCentimeters Int?
  age                 Int?
  bodyFatPercentage   Int? // 100 representa 100%
  gamificationTheme   String           @default("ALL")
  createdExercises    Exercise[]

  workoutSessions     WorkoutSession[]
  periodizations      Periodization[]
  aiConversations     AiConversation[]
  aiToolExecutions    AiToolExecution[]
  aiUsageDaily        AiUsageDaily[]
  aiRequestLogs       AiRequestLog[]
  feedbacks           Feedback[]
  metricLogs          UserMetricLog[]
  coachAthletesAsCoach    CoachAthlete[]    @relation("CoachLinks")
  coachAthletesAsAthlete  CoachAthlete[]    @relation("AthleteLinks")
  revokedCoachAthletes    CoachAthlete[]    @relation("RevokedLinks")
  coachInvitations        CoachInvitation[] @relation("CoachInvitations")
  acceptedInvitations     CoachInvitation[] @relation("AthleteAcceptedInvitations")
  coachPrescriptions      WorkoutPrescription[] @relation("CoachPrescriptions")
  athletePrescriptions    WorkoutPrescription[] @relation("AthletePrescriptions")
  aiTrainingHistoryAccess Boolean          @default(false)
  aiTrainingHistoryConsentAt DateTime?     @db.Timestamptz()
  workoutSetProposals     WorkoutSetProposal[]

  @@unique([email])
  @@map("user")
}

model WorkoutPlan {
  id        String    @id @default(uuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()

  workoutDays       WorkoutDay[]
  periodizationPlan PeriodizationPlan?
  workoutSessions   WorkoutSession[]
  acceptedPrescription WorkoutPrescription?

  @@index([userId, deletedAt])
}

model Periodization {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  goal        String?
  notes       String?
  isActive    Boolean   @default(false)
  startedAt   DateTime? @db.Timestamptz()
  completedAt DateTime? @db.Timestamptz()
  deletedAt   DateTime? @db.Timestamptz()
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  plans       PeriodizationPlan[]

  @@index([userId, createdAt])
  @@index([userId, deletedAt])
}

model PeriodizationPlan {
  id               String        @id @default(uuid())
  periodizationId  String
  periodization    Periodization @relation(fields: [periodizationId], references: [id], onDelete: Cascade)
  workoutPlanId    String        @unique
  workoutPlan      WorkoutPlan   @relation(fields: [workoutPlanId], references: [id], onDelete: Restrict)
  order            Int
  plannedStartDate DateTime?     @db.Date
  plannedEndDate   DateTime?     @db.Date
  activatedAt      DateTime?     @db.Timestamptz()
  completedAt      DateTime?     @db.Timestamptz()
  notes            String?
  createdAt        DateTime      @default(now()) @db.Timestamptz()
  updatedAt        DateTime      @updatedAt @db.Timestamptz()

  @@unique([periodizationId, order])
}

model WorkoutDay {
  id                         String            @id @default(uuid())
  name                       String
  workoutPlanId              String
  workoutPlan                WorkoutPlan       @relation(fields: [workoutPlanId], references: [id])
  isRest                     Boolean           @default(false)
  estimatedDurationInSeconds Int
  coverImageUrl              String?
  weekDay                    WeekDay           @default(MONDAY)
  order                      Int               @default(0)
  exercises                  WorkoutExercise[]
  createdAt                  DateTime          @default(now()) @db.Timestamptz()
  updatedAt                  DateTime          @updatedAt @db.Timestamptz()
  sessions                   WorkoutSession[]
}

model Exercise {
  id          String   @id @default(uuid())
  ownerUserId String?
  ownerUser   User?    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()

  workoutExercises             WorkoutExercise[] @relation("WorkoutExerciseMain")
  workoutExercisesAlternative1 WorkoutExercise[] @relation("WorkoutExerciseAlternative1")
  workoutExercisesAlternative2 WorkoutExercise[] @relation("WorkoutExerciseAlternative2")
  sessionExercises             SessionExercise[] @relation("SessionExerciseMain")
  sessionExercisesPlanned      SessionExercise[] @relation("SessionExercisePlanned")
  sessionExercisesAlternative1 SessionExercise[] @relation("SessionExerciseAlternative1")
  sessionExercisesAlternative2 SessionExercise[] @relation("SessionExerciseAlternative2")
  muscles                      ExerciseMuscle[]
  media                        ExerciseMedia[]
  workoutSets                  WorkoutSet[]      @relation("WorkoutSetExercise")
  workoutSetProposals          WorkoutSetProposal[]

  @@index([ownerUserId, name])
}

model ExerciseMedia {
  id                 String            @id @default(uuid())
  exerciseId         String
  exercise           Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  provider           String            // Ex: "REPDB"
  providerExerciseId String            // Ex: "bench-press"
  mediaType          ExerciseMediaType @default(IMAGE_SEQUENCE)
  startImagePath     String?           // Ex: "/exercise-media/repdb/bench-press-start.webp"
  endImagePath       String?           // Ex: "/exercise-media/repdb/bench-press-peak.webp"
  motionPath         String?           // Futuros gifs/vídeos
  description        String?
  instructions       Json?
  attributionName    String            @default("RepDB")
  attributionUrl     String            @default("https://repdb.co")
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now()) @db.Timestamptz()
  updatedAt          DateTime          @updatedAt @db.Timestamptz()

  @@unique([exerciseId, provider, mediaType])
  @@index([exerciseId, isActive])
  @@index([provider, providerExerciseId])
}

model ExerciseMuscle {
  id          String      @id @default(uuid())

  exerciseId  String
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  muscleGroup MuscleGroup
  role        MuscleRole

  createdAt   DateTime    @default(now()) @db.Timestamptz()

  @@unique([exerciseId, muscleGroup])
  @@index([muscleGroup, role])
}

model WorkoutExercise {
  id                String     @id @default(uuid())
  name              String
  order             Int
  workoutDayId      String
  workoutDay        WorkoutDay @relation(fields: [workoutDayId], references: [id])
  sets              Int
  warmupSets        Int        @default(0)
  reps              Int
  restTimeInSeconds Int
  createdAt         DateTime   @default(now()) @db.Timestamptz()
  updatedAt         DateTime   @updatedAt @db.Timestamptz()

  exerciseId                 String?
  exercise                   Exercise?         @relation("WorkoutExerciseMain", fields: [exerciseId], references: [id], onDelete: SetNull)
  alternative1ExerciseId     String?
  alternative1Exercise       Exercise?         @relation("WorkoutExerciseAlternative1", fields: [alternative1ExerciseId], references: [id], onDelete: SetNull)
  alternative2ExerciseId     String?
  alternative2Exercise       Exercise?         @relation("WorkoutExerciseAlternative2", fields: [alternative2ExerciseId], references: [id], onDelete: SetNull)
  sessionExercises           SessionExercise[]

  @@index([exerciseId])
  @@index([alternative1ExerciseId])
  @@index([alternative2ExerciseId])
}

model WorkoutSession {
  id                      String               @id @default(uuid())
  origin                  WorkoutSessionOrigin
  workoutDayId            String?
  workoutDay              WorkoutDay?          @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)
  workoutPlanId           String?
  workoutPlan             WorkoutPlan?         @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  workoutPlanNameSnapshot String?
  workoutDayNameSnapshot  String?
  athleteId               String
  athlete                 User                 @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  startedAt               DateTime             @db.Timestamptz()
  completedAt             DateTime?            @db.Timestamptz()
  createdAt               DateTime             @default(now()) @db.Timestamptz()
  updatedAt               DateTime             @updatedAt @db.Timestamptz()

  sessionExercises        SessionExercise[]
  proposals               WorkoutSetProposal[]
  aiConversations         AiConversation[]

  @@index([athleteId, startedAt])
  @@index([athleteId, completedAt])
  @@index([workoutPlanId])
}

model SessionExercise {
  id                      String           @id @default(uuid())
  workoutSessionId        String
  workoutSession          WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  sourceWorkoutExerciseId String?
  sourceWorkoutExercise   WorkoutExercise? @relation(fields: [sourceWorkoutExerciseId], references: [id], onDelete: SetNull)

  exerciseId              String?
  exercise                Exercise?        @relation("SessionExerciseMain", fields: [exerciseId], references: [id], onDelete: SetNull)

  exerciseNameSnapshot    String
  order                   Int

  plannedExerciseId              String?
  plannedExercise                Exercise?        @relation("SessionExercisePlanned", fields: [plannedExerciseId], references: [id], onDelete: SetNull)
  plannedExerciseNameSnapshot    String?

  alternative1ExerciseId         String?
  alternative1Exercise           Exercise?        @relation("SessionExerciseAlternative1", fields: [alternative1ExerciseId], references: [id], onDelete: SetNull)
  alternative1ExerciseNameSnapshot String?

  alternative2ExerciseId         String?
  alternative2Exercise           Exercise?        @relation("SessionExerciseAlternative2", fields: [alternative2ExerciseId], references: [id], onDelete: SetNull)
  alternative2ExerciseNameSnapshot String?

  wasSubstituted                 Boolean          @default(false)
  substitutedAt                  DateTime?        @db.Timestamptz()

  plannedSets              Int?
  plannedWarmupSets        Int?
  plannedReps              Int?
  plannedRestTimeInSeconds Int?

  notes                   String?
  createdAt               DateTime         @default(now()) @db.Timestamptz()
  updatedAt               DateTime         @updatedAt @db.Timestamptz()

  revision                Int              @default(1)
  proposals               WorkoutSetProposal[]

  sets                    WorkoutSet[]

  @@index([workoutSessionId, order])
  @@index([exerciseId])
  @@index([exerciseId, workoutSessionId])
  @@index([plannedExerciseId])
  @@index([alternative1ExerciseId])
  @@index([alternative2ExerciseId])
}

model WorkoutSet {
  id                   String              @id @default(uuid())
  sessionExerciseId    String
  sessionExercise      SessionExercise     @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  exerciseId           String?
  exercise             Exercise?           @relation("WorkoutSetExercise", fields: [exerciseId], references: [id], onDelete: SetNull)
  exerciseNameSnapshot String?

  proposalId           String?
  proposal             WorkoutSetProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  order                Int
  type                 SetType             @default(WORKING)

  weightInGrams        Int?
  reps                 Int?
  rir                  Int?
  durationInSeconds    Int?

  notes                String?
  completedAt          DateTime?           @db.Timestamptz()

  createdAt            DateTime            @default(now()) @db.Timestamptz()
  updatedAt            DateTime            @updatedAt @db.Timestamptz()

  @@index([sessionExerciseId, order])
  @@index([sessionExerciseId, type, completedAt])
  @@index([exerciseId])
  @@index([proposalId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime    @default(now()) @db.Timestamptz()
  updatedAt DateTime    @updatedAt @db.Timestamptz()

  workoutSessionId String?
  workoutSession   WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  messages  AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([workoutSessionId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sdkMessageId   String
  payload        Json
  createdAt      DateTime       @default(now()) @db.Timestamptz()

  @@unique([conversationId, sdkMessageId])
  @@index([conversationId, createdAt(sort: Asc)])
}

model AiToolExecution {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCallId String
  toolName   String
  result     Json
  createdAt  DateTime @default(now()) @db.Timestamptz()

  @@unique([userId, toolCallId])
  @@index([userId, toolName])
}

enum AccountType {
  ATHLETE
  COACH
}

enum SystemRole {
  USER
  ADMIN
}

enum PlanAudience {
  ATHLETE
  COACH
  INTERNAL
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingProvider {
  NONE
  MANUAL
  ASAAS
}

enum EntitlementKey {
  COACH_DASHBOARD
  MANAGE_ATHLETES
  ASSIGN_WORKOUTS
  VIEW_ATHLETE_HISTORY
  ADVANCED_STATS
  AI_CHAT
  AI_PLAN_GENERATION
  SOURCE_LIBRARY
}

model Plan {
  id                  String @id @default(uuid())
  code                String @unique
  name                String
  description         String?
  audience            PlanAudience
  monthlyPriceInCents  Int
  currency            String @default("BRL")
  isPublic            Boolean @default(false)
  isActive            Boolean @default(true)
  sortOrder           Int @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz()
  updatedAt           DateTime @updatedAt @db.Timestamptz()
  entitlements        PlanEntitlement[]
  subscriptions       Subscription[]
  signupIntents       SignupIntent[]
}

model PlanEntitlement {
  id          String @id @default(uuid())
  planId      String
  plan        Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement EntitlementKey
  limitValue  Int?
  createdAt   DateTime @default(now()) @db.Timestamptz()
  @@unique([planId, entitlement])
}

model Subscription {
  id                      String @id @default(uuid())
  userId                  String @unique
  user                    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                  String
  plan                    Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                  SubscriptionStatus
  billingProvider         BillingProvider @default(NONE)
  priceInCentsSnapshot     Int
  currencySnapshot        String
  externalSubscriptionId  String?
  trialStartedAt          DateTime? @db.Timestamptz()
  trialEndsAt             DateTime? @db.Timestamptz()
  currentPeriodStart      DateTime? @db.Timestamptz()
  currentPeriodEnd        DateTime? @db.Timestamptz()
  canceledAt              DateTime? @db.Timestamptz()
  createdAt               DateTime @default(now()) @db.Timestamptz()
  updatedAt               DateTime @updatedAt @db.Timestamptz()
  @@index([planId])
  @@unique([billingProvider, externalSubscriptionId])
}

model BillingCustomer {
  id                  String @id @default(uuid())
  userId              String
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            BillingProvider
  externalCustomerId  String
  createdAt           DateTime @default(now()) @db.Timestamptz()
  updatedAt           DateTime @updatedAt @db.Timestamptz()
  @@unique([userId, provider])
  @@unique([provider, externalCustomerId])
}

model SignupIntent {
  id          String @id @default(uuid())
  tokenHash   String @unique
  accountType AccountType
  planId      String
  plan        Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  expiresAt   DateTime @db.Timestamptz()
  consumedAt  DateTime? @db.Timestamptz()
  createdAt   DateTime @default(now()) @db.Timestamptz()
  @@index([expiresAt])
}

enum AdminAuditAction {
  PLAN_UPDATED
  PLAN_ENTITLEMENTS_UPDATED
  SUBSCRIPTION_TRIAL_GRANTED
  SUBSCRIPTION_TRIAL_EXTENDED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_CANCELED
}

model AdminAuditLog {
  id           String @id @default(uuid())
  adminUserId  String
  admin        User @relation("AuditActor", fields: [adminUserId], references: [id], onDelete: Restrict)
  action       AdminAuditAction
  targetUserId String?
  targetUser   User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz()

  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt, id])
}

model AiUsageDaily {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD" em UTC
  count     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([userId, date])
  @@index([date])
}

model AiRequestLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  QUESTION
  OTHER
}

model Feedback {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  FeedbackCategory @default(SUGGESTION)
  message   String
  createdAt DateTime         @default(now()) @db.Timestamptz()

  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserMetricLog {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightInGrams       Int
  heightInCentimeters Int?
  age                 Int?
  bodyFatPercentage   Int?
  loggedAt            DateTime @default(now()) @db.Timestamptz()
  createdAt           DateTime @default(now()) @db.Timestamptz()

  @@index([userId, loggedAt(sort: Desc)])
  @@index([createdAt])
  @@map("user_metric_log")
}

enum CoachAthleteStatus {
  ACTIVE
  REVOKED
}

enum CoachInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model CoachInvitation {
  id                  String                @id @default(uuid())
  coachId             String
  coach               User                  @relation("CoachInvitations", fields: [coachId], references: [id], onDelete: Cascade)
  tokenHash           String                @unique
  status              CoachInvitationStatus @default(PENDING)
  expiresAt           DateTime              @db.Timestamptz()
  acceptedAt          DateTime?             @db.Timestamptz()
  acceptedByAthleteId String?
  acceptedByAthlete   User?                 @relation("AthleteAcceptedInvitations", fields: [acceptedByAthleteId], references: [id], onDelete: SetNull)
  cancelledAt         DateTime?             @db.Timestamptz()
  createdAt           DateTime              @default(now()) @db.Timestamptz()
  updatedAt           DateTime              @updatedAt @db.Timestamptz()
  coachAthlete        CoachAthlete?

  @@index([coachId, status])
  @@index([expiresAt])
  @@index([createdAt])
}

model CoachAthlete {
  id              String             @id @default(uuid())
  coachId         String
  coach           User               @relation("CoachLinks", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId       String
  athlete         User               @relation("AthleteLinks", fields: [athleteId], references: [id], onDelete: Cascade)
  status          CoachAthleteStatus @default(ACTIVE)
  invitationId    String?            @unique
  invitation      CoachInvitation?   @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now()) @db.Timestamptz()
  updatedAt       DateTime           @updatedAt @db.Timestamptz()
  revokedAt       DateTime?          @db.Timestamptz()
  revokedByUserId String?
  revokedByUser   User?              @relation("RevokedLinks", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  // Task 6.3: Consentimento explícito e escopo temporal para acompanhamento de evolução
  evolutionShared         Boolean            @default(false)
  includePreviousHistory  Boolean            @default(false)
  evolutionSharedAt       DateTime?          @db.Timestamptz()
  evolutionRevokedAt      DateTime?          @db.Timestamptz()

  @@index([coachId, status])
  @@index([athleteId, status])
  @@index([createdAt])
}

enum WorkoutPrescriptionStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CANCELLED
}

model WorkoutPrescription {
  id                    String                    @id @default(uuid())
  coachId               String
  coach                 User                      @relation("CoachPrescriptions", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId             String
  athlete               User                      @relation("AthletePrescriptions", fields: [athleteId], references: [id], onDelete: Cascade)
  status                WorkoutPrescriptionStatus @default(DRAFT)
  name                  String
  notes                 String?
  payload               Json
  version               Int                       @default(1)
  acceptedWorkoutPlanId String?                   @unique
  acceptedWorkoutPlan   WorkoutPlan?              @relation(fields: [acceptedWorkoutPlanId], references: [id], onDelete: SetNull)
  sentAt                DateTime?                 @db.Timestamptz()
  respondedAt           DateTime?                 @db.Timestamptz()
  createdAt             DateTime                  @default(now()) @db.Timestamptz()
  updatedAt             DateTime                  @updatedAt @db.Timestamptz()

  @@index([coachId, status])
  @@index([athleteId, status])
  @@index([createdAt])
}

enum WorkoutSetProposalStatus {
  PENDING
  CONFIRMED
  DISCARDED
  INVALIDATED
  SUPERSEDED
}

model WorkoutSetProposal {
  id                            String                   @id @default(uuid())
  userId                        String
  user                          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSessionId              String
  workoutSession                WorkoutSession           @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sessionExerciseId             String
  sessionExercise               SessionExercise          @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  targetExerciseId              String?
  targetExercise                Exercise?                @relation(fields: [targetExerciseId], references: [id], onDelete: SetNull)
  targetExerciseNameSnapshot    String
  targetSessionExerciseRevision Int

  status                        WorkoutSetProposalStatus @default(PENDING)
  invalidationReason            String?

  suggestedSets                 Json
  confirmedSets                 Json?

  idempotencyKey                String?                  @unique
  expiresAt                     DateTime                 @db.Timestamptz()
  confirmedAt                   DateTime?                @db.Timestamptz()
  discardedAt                   DateTime?                @db.Timestamptz()

  createdAt                     DateTime                 @default(now()) @db.Timestamptz()
  updatedAt                     DateTime                 @updatedAt @db.Timestamptz()

  workoutSets                   WorkoutSet[]

  @@index([workoutSessionId, status])
  @@index([sessionExerciseId, status])
  @@index([userId, status])
}


