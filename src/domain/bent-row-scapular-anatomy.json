  "sources": [
    {
      "id": "FENWICK_2009",
      "title": "Fenwick, Brown & McGill — Comparison of Different Rowing Exercises (2009)",
      "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/",
      "limitation": "Sete homens; remada curvada em pé, invertida e unilateral no cabo. Biomecânica/EMG aguda e amostra pequena; não comprova hipertrofia, segurança universal ou equivalência à remada apoiada com halter."
    },
    {
      "id": "KANNO_2025",
      "title": "Kanno et al. — Trunk flexion angle during bent-over rows (2025; online 2026)",
