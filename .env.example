# Server & Environment
PORT=8080
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host/test_database?sslmode=require

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-better-auth-secret-here

# URLs & Origins
# API_BASE_URL: URL física da API Fastify (servidores OpenAPI/Swagger).
# Em homologação Vercel: https://trainvy-api.vercel.app
API_BASE_URL=http://localhost:8080

# AUTH_BASE_URL: URL pública dos endpoints de autenticação Better Auth (opcional).
# Em homologação Vercel com rewrite /backend: https://trainvy.vercel.app/backend/api/auth
# Quando omitida ou vazia, deriva automaticamente de ${API_BASE_URL}/api/auth (padrão local).
AUTH_BASE_URL=

# WEB_APP_BASE_URL: URL do frontend para CORS e redirecionamentos pós-login
WEB_APP_BASE_URL=http://localhost:3000

# Cookie Configuration
# When set (e.g. trainvy.com.br), enables cross-subdomain cookies for app.trainvy.com.br and api.trainvy.com.br.
# When empty or omitted, crossSubDomainCookies is disabled and cookies are host-only (default for localhost & *.vercel.app).
AUTH_COOKIE_DOMAIN=

# Optional: comma-separated list of additional allowed origins (e.g. Vercel preview deployments)
ADDITIONAL_TRUSTED_ORIGINS=

# Social Providers (Google OAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Providers
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=

# AI Safety Limits (Infrastructure & Burst Protection)
# Nota: Limites diários de uso para alunos e coaches são configurados diretamente no painel /admin (Planos Comerciais > Permissões).
# Limite por minuto anti-burst (anti-spam)
AI_MINUTE_USER_LIMIT=3
# Limite global diário de proteção de infraestrutura
AI_DAILY_GLOBAL_LIMIT=500

# Admin configuration (comma-separated list of emails with automatic ADMIN role)
ADMIN_EMAILS=admin@example.com
# Professional verification: human review only; no scraping or automatic approval.
PROFESSIONAL_VERIFICATION_VALIDITY_DAYS=180
# Comma-separated exact official hostnames approved by operations (no wildcards).
PROFESSIONAL_OFFICIAL_SOURCE_HOSTS=

# Push Notifications (Web Push / VAPID)
VAPID_PUBLIC_KEY=123123
VAPID_PRIVATE_KEY=123123
VAPID_SUBJECT=mailto:123123@123123.123
CRON_SECRET=123123123

